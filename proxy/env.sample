# Lokus Inference Proxy — environment.
# Copy to .env and fill in. NEVER commit real keys. Provider / service-role keys
# load ONLY from env; placeholders below.

# --- Server ---
PORT=3000

# --- Supabase (service role: server-only, full RPC access) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Redis (rate-limit + idempotency store) ---
REDIS_URL=redis://localhost:6379

# --- Providers ---
ANTHROPIC_API_KEY=replace-with-anthropic-key
OPENAI_API_KEY=replace-with-openai-key
LOKUS_DEEPGRAM_KEY=replace-with-deepgram-key

# --- Local models ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Optional ---
OPENROUTER_API_KEY=
