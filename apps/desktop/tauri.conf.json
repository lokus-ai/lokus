{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lokus",
  "identifier": "io.lokus.app",
  "build": {
    "beforeDevCommand": { "script": "pnpm dev:ui", "cwd": "../.." },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "pnpm build:ui", "cwd": "../.." },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lokus",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co https://*.posthog.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
