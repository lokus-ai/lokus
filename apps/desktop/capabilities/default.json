{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Every window may talk to the core, drag itself and open a folder picker. Nothing else.",
  "windows": [
    "main",
    "w-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "dialog:allow-open"
  ]
}
